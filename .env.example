# Runtime
EOH_HOST=0.0.0.0
EOH_PORT=8787
EOH_DATA_DIR=./data
EOH_API_TOKEN=

# Provider: mock or openai-compatible
EOH_PROVIDER=mock
EOH_LLM_BASE_URL=https://api.openai.com/v1
EOH_LLM_API_KEY=
EOH_PRIMARY_MODEL=model-name
EOH_FALLBACK_BASE_URL=
EOH_FALLBACK_API_KEY=
EOH_FALLBACK_MODEL=
EOH_PROVIDER_COST_CENTS=1
EOH_FAILURE_COST_CENTS=0
EOH_REQUEST_TIMEOUT_SECONDS=45

# Optional, public website context only. HTTPS and public IPs are enforced.
EOH_SCRAPE_COMPANY_SITES=0
EOH_ALLOW_HTTP_COMPANY_URLS=0

# Earn-or-Halt policy
EOH_STARTING_CREDIT_CENTS=100
EOH_GRACE_JOBS=3
EOH_MINIMUM_MARGIN_PERCENT=20
EOH_DAILY_COST_CAP_CENTS=500
EOH_MAXIMUM_CONSECUTIVE_FAILURES=5
EOH_MAXIMUM_IDLE_CYCLES=0
EOH_HALT_ON_NO_FUNDS=1
EOH_POLL_INTERVAL_SECONDS=1

# Signed bootstrap. Local demo uses file; production can use url or blockscout.
EOH_POINTER_SOURCE=file
EOH_POINTER_FILE=./manifest.json
EOH_POINTER_URL=
EOH_BLOCKSCOUT_BASE=https://eth.blockscout.com
EOH_VANITY_ADDRESSES=
EOH_IPFS_GATEWAYS=https://ipfs.io,https://dweb.link
EOH_RELEASE_PUBKEY=./release-public.pem
EOH_INSTALL_ROOT=./.install
EOH_FOREGROUND=1
EOH_REMOVE_BOOTSTRAP=0
